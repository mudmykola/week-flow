# Google OAuth Web application credentials.
# Local callback: http://localhost:3000/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Generate a unique value with at least 32 characters. Never reuse production secrets.
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
